# Copy to .env.production before: docker compose up --build
# Database (host is overridden to "postgres" in docker-compose.yml)
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-in-production
DATABASE_NAME=nestjs-blog
DATABASE_HOST=postgres
DATABASE_SYNC=false
DATABASE_AUTOLOAD=true

PORT=3000

PROFILE_API_KEY=your_api_key_here
JWT_SECRET=change-me-use-a-long-random-secret
JWT_TOKEN_AUDIENCE=localhost:3000
JWT_TOKEN_ISSUER=localhost:3000
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

API_VERSION=0.0.1

AWS_PUBLIC_BUCKET_NAME=nestjs-blog
AWS_REGION=default
AWS_CLOUDFRONT_URL=none
AWS_ACCESS_KEY_ID=this_key
AWS_SECRET_ACCESS_KEY=this_key

ARVAN_BUCKET_NAME=your-bucket-name
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_CLOUDFRONT_URL=your-bucket-address
ARVAN_ACCESS_KEY=your-access-key
ARVAN_SECRET_KEY=your-secret-key

MAIL_HOST=sandbox.smtp.mailtrap.io
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
